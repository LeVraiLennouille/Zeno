{
  "expo": {
    "name": "Zeno",
    "slug": "zeno",
    "scheme": "zeno",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EDEEF0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.zeno.habits"
    },
    "android": {
      "package": "app.zeno.habits",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EDEEF0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Zeno",
      "shortName": "Zeno",
      "lang": "fr",
      "themeColor": "#EDEEF0",
      "backgroundColor": "#EDEEF0"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEEF0",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12131A"
        }
      ],
      "expo-audio",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}