{
  "name": "zeno",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.domain.json && node --require ./tests/setup-tz.cjs --test tests/*.test.cjs",
    "generate:icons": "node scripts/generate-icons.cjs",
    "check:ui": "node scripts/check-ui.cjs",
    "typecheck:shim": "tsc -p scripts/tsconfig.shim.json",
    "check": "npm test && npm run check:ui && npm run check:a11y && npm run typecheck:shim",
    "check:a11y": "node scripts/check-a11y.cjs",
    "generate:sounds": "node scripts/generate-sounds.cjs",
    "install:deps": "node scripts/install-deps.cjs",
    "verify": "node scripts/verify-files.cjs"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.3.0",
    "expo": "^58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  }
}
